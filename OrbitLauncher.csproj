<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>OrbitLauncher</RootNamespace>
    <AssemblyName>OrbitLauncher</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.8.7</Version>
    <Product>OrbitLauncher</Product>
    <Description>OrbitLauncher – Minecraft Launcher</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- small download, but unpacked only once per version (to %TEMP%\.net); every later start loads straight from disk -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>none</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <!-- small memory footprint: no background GC thread, conserve memory, precompiled code (less JIT memory) -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  <!-- Microsoft app id for the login (public, it ships inside the exe anyway). Override with -p:OrbitClientId=<id> -->
  <PropertyGroup>
    <OrbitClientId Condition="'$(OrbitClientId)' == ''">1be45128-ad50-4832-9b1e-f44c0bff2956</OrbitClientId>
  </PropertyGroup>
  <!-- API key for the extended catalog: from .secrets/catalog.key (never committed) or -p:CatalogKey=<key> -->
  <PropertyGroup Condition="'$(CatalogKey)' == '' And Exists('$(MSBuildProjectDirectory)/.secrets/catalog.key')">
    <CatalogKey>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/.secrets/catalog.key').Trim())</CatalogKey>
  </PropertyGroup>
  <ItemGroup Condition="'$(CatalogKey)' != ''">
    <AssemblyMetadata Include="CatalogKey" Value="$(CatalogKey)" />
  </ItemGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(OrbitClientId)' != ''">
    <AssemblyMetadata Include="OrbitClientId" Value="$(OrbitClientId)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Compile Remove="tests/**;client-mod/**" />
    <None Remove="tests/**;client-mod/**" />
    <Page Remove="tests/**" />
    <EmbeddedResource Include="Web\**\*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Orbit Client mod, built from client-mod/ (./gradlew build) and copied here -->
    <EmbeddedResource Include="Assets\orbitclient.jar" LogicalName="mod/orbitclient.jar" />
  </ItemGroup>
</Project>
